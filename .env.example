# Project URL. Public, but on its own it opens nothing: migration 0005 revoked
# every anonymous grant on the `fitness` schema.
NEXT_PUBLIC_SUPABASE_URL=https://wkpsjyklzsbvtiorbgjd.supabase.co

# Server only. Never prefix these with NEXT_PUBLIC.
# The service-role key is the only database credential the app uses.
SUPABASE_SERVICE_ROLE_KEY=
# Signs the session cookie. 32+ random bytes, e.g. `openssl rand -base64 32`.
# Changing it signs every device out.
AUTH_SECRET=
# The passcode that unlocks the app. Required: without it nothing is served.
FITNESS_WRITE_PASSCODE=
