# Public: safe in the browser. The anon key only works because RLS grants
# SELECT and nothing else.
NEXT_PUBLIC_SUPABASE_URL=https://wkpsjyklzsbvtiorbgjd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix these with NEXT_PUBLIC.
# The service-role key bypasses RLS and is the single write path.
SUPABASE_SERVICE_ROLE_KEY=
# Required for any write to succeed. Writes are disabled while it is unset.
FITNESS_WRITE_PASSCODE=
